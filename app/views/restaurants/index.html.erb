<div class="container mt-4 p-1">
  <h1>Restaurants 🍽️</h1>
  <div class="row">

    <% @restaurant.each do |restaurant|%>
    <div class="col-12 col-md-6 col-lg-4 p-1">
      <div class="card mb-4 p-3 h-100">
        <div class="mt-2">
          <p><strong><%= restaurant.name %></strong></p>
          <p><%= link_to "See more", restaurant_path(restaurant), class: "btn btn-outline-secondary" %></p>
        </div>
      </div>
    </div>
    <% end %>
  </div>

  <div class="row p-1"><%= link_to "Create New Restaurant", new_restaurant_path, class: "btn btn-outline-primary" %></div>
</div>
