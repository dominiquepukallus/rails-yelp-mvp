<div class="container mt-10px">
  <%= link_to "Back", restaurants_path, class: "btn btn-outline-secondary mb-3"%>

  <%# restaurant card %>
  <div class="card mb-4">
    <h1><%= @restaurant.name %></h1>
    <p><strong>Address:</strong> <%= @restaurant.address %></p>
    <p><strong>Cuisine:</strong> <%= @restaurant.category %></p>
  </div>


  <h2>Reviews</h2>
  <ul class="list-group">
    <% @restaurant.reviews.each do |review| %>
      <li class="list-group-item"><%= review.content %></li>
      <li class="list-group-item"><%= review.rating %></li>
    <% end %>
  </ul>

  <%= link_to "Create new review", new_restaurant_review_path(@restaurant) %>
</div>
